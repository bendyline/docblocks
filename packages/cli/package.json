{
  "name": "@bendyline/docblocks-cli",
  "version": "2.2.1",
  "description": "Build, preview, convert, render, inspect, and automate documents",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/docblocks.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docblocks.com/cli/",
  "keywords": [
    "docblocks",
    "cli",
    "markdown"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "docblocks": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bendyline/docblocks": "2.2.1",
    "@bendyline/squisq": "2.3.3",
    "@bendyline/squisq-cli": "2.3.3",
    "@bendyline/squisq-formats": "2.3.3",
    "@bendyline/squisq-react": "2.3.3",
    "@bendyline/squisq-video": "2.2.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "13.1.0",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.58.2",
    "zod": "3.25.76"
  }
}
