{
  "name": "docblocks-mobile",
  "version": "1.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsx ../../scripts/vite-build.ts",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "sync:ios": "cap sync ios && node scripts/normalize-ios.mjs",
    "sync:android": "cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@bendyline/docblocks": "2.7.12",
    "@bendyline/docblocks-react": "2.7.12",
    "@bendyline/gezel": "1.2.13",
    "@bendyline/gezel-app-sdk": "1.1.13",
    "@bendyline/gezel-capacitor": "1.0.0",
    "@bendyline/squisq": "2.13.12",
    "@bendyline/squisq-editor-react": "2.13.19",
    "@bendyline/squisq-formats": "2.8.14",
    "@bendyline/squisq-react": "2.12.24",
    "@bendyline/squisq-video": "2.4.18",
    "@bendyline/squisq-video-react": "2.5.25",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@ironcalc/wasm": "0.8.4",
    "harper.js": "2.7.0",
    "monaco-editor": "0.50.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
