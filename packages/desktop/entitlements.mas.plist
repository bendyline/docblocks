<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store entitlements (parent / main app).

  MAS builds run inside the App Sandbox, so unlike the Developer ID
  entitlements.mac.plist this file grants sandbox capabilities rather than
  hardened-runtime exceptions:

    - app-sandbox               required for the Mac App Store
    - files.user-selected.*     read/write folders the user picks via a dialog
    - files.bookmarks.app-scope persist that access across launches via
                                security-scoped bookmarks (see ipc-workspaces)
    - network.client            outbound network for any fetch the app makes
    - device.camera             the recorder's camera capture
    - device.audio-input        the recorder's microphone capture

  Without the two device.* keys the sandbox does not refuse capture outright —
  getUserMedia still resolves — it just delivers black frames and silence, so
  the recorder looks broken with no error to show.

  Do NOT copy the allow-jit / allow-unsigned-executable-memory keys from the
  Developer ID entitlements here — those are hardened-runtime concepts and are
  rejected by App Store review.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- The export textbox defaults to Downloads and writes there without
       opening a redundant Save dialog. Other locations remain user-selected. -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Document narration and video recording. The NSCameraUsageDescription /
       NSMicrophoneUsageDescription strings that accompany these live in the
       `mas` build's inherited extendInfo — keep the two in step. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
