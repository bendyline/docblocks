{
  "name": "docblocks-desktop",
  "version": "2.2.0",
  "private": true,
  "description": "DocBlocks desktop application — native wrapper around the DocBlocks editor.",
  "author": "Bendyline",
  "license": "MIT",
  "homepage": "https://docblocks.com/desktop/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/docblocks.git",
    "directory": "packages/desktop"
  },
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "predev": "npm run build:main",
    "dev": "concurrently -k -n vite,electron -c \"blue,green\" \"vite --config vite.config.ts\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://localhost:5221 && tsup --config tsup.config.ts --watch --no-clean --onSuccess \"node scripts/run-electron.cjs\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsup --config tsup.config.ts",
    "build:renderer": "tsc --noEmit -p tsconfig.renderer.json && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.e2e.json",
    "prepare:windows-updater": "tsx scripts/prepare-windows-updater-manifest.ts dist/artifacts/latest.yml",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mas": "npm run build && electron-builder --mac mas",
    "dist:appx": "npm run build && electron-builder --win appx",
    "dist:snap": "npm run build && electron-builder --linux snap",
    "dist:flatpak": "npm run build && electron-builder --linux flatpak",
    "dist:dir": "npm run build && electron-builder --dir",
    "start": "node scripts/run-electron.cjs",
    "icons": "python3 scripts/generate-icons.py",
    "test:e2e": "npm run build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:packaged": "npm run dist:dir && npm run test:e2e:packaged:only",
    "test:e2e:packaged:only": "playwright test --config=e2e/playwright.packaged.config.ts"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "electron-updater": "6.3.9",
    "electron-window-state": "5.0.3"
  },
  "devDependencies": {
    "@bendyline/docblocks": "2.2.0",
    "@bendyline/docblocks-react": "2.2.0",
    "@bendyline/squisq": "2.3.3",
    "@bendyline/squisq-editor-react": "2.3.4",
    "@bendyline/squisq-formats": "2.3.3",
    "@bendyline/squisq-react": "2.3.3",
    "@bendyline/squisq-video": "2.2.3",
    "@bendyline/squisq-video-react": "2.2.3",
    "@electron/notarize": "2.5.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
    "mocha": "11.3.0",
    "monaco-editor": "0.50.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "wait-on": "8.0.1"
  }
}
