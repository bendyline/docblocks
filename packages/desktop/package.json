{
  "name": "docblocks-desktop",
  "version": "2.6.0",
  "private": true,
  "description": "DocBlocks desktop application — native wrapper around the DocBlocks editor.",
  "author": "Bendyline",
  "license": "MIT",
  "homepage": "https://docblocks.com/desktop/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/docblocks.git",
    "directory": "packages/desktop"
  },
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "predev": "npm run build:main",
    "dev": "node scripts/dev.cjs",
    "dev:electron": "wait-on http://localhost:5221 && tsup --config tsup.dev.config.ts --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsup --config tsup.config.ts",
    "build:renderer": "tsc --noEmit -p tsconfig.renderer.json && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.e2e.json",
    "prepare:windows-updater": "tsx scripts/prepare-windows-updater-manifest.ts dist/artifacts/latest.yml",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && npm run package:linux:x64 && npm run package:linux:arm64",
    "package:linux:x64": "electron-builder --linux AppImage deb --x64",
    "package:linux:arm64": "electron-builder --linux AppImage deb --arm64",
    "dist:mas": "npm run build && electron-builder --mac mas",
    "dist:appx": "npm run build && electron-builder --win appx",
    "dist:snap": "npm run build && electron-builder --linux snap",
    "dist:flatpak": "npm run build && electron-builder --linux flatpak",
    "dist:dir": "npm run build && electron-builder --dir -c.mac.hardenedRuntime=false",
    "start": "node scripts/run-electron.cjs",
    "icons": "python3 scripts/generate-icons.py",
    "test:e2e": "npm run build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:packaged": "npm run dist:dir && npm run test:e2e:packaged:only",
    "test:e2e:packaged:only": "playwright test --config=e2e/playwright.packaged.config.ts"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "electron-updater": "6.8.9",
    "electron-window-state": "5.0.3"
  },
  "devDependencies": {
    "@bendyline/docblocks": "2.6.0",
    "@bendyline/docblocks-react": "2.6.0",
    "@bendyline/squisq": "2.11.1",
    "@bendyline/squisq-editor-react": "2.11.1",
    "@bendyline/squisq-formats": "2.6.1",
    "@bendyline/squisq-react": "2.11.1",
    "@bendyline/squisq-video": "2.3.4",
    "@bendyline/squisq-video-react": "2.4.5",
    "@electron/notarize": "2.5.0",
    "@ironcalc/wasm": "0.8.4",
    "@playwright/test": "1.58.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "harper.js": "2.7.0",
    "mocha": "11.3.0",
    "monaco-editor": "0.50.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tree-kill": "1.2.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "wait-on": "8.0.1"
  }
}
