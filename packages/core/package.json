{
  "name": "@bendyline/docblocks",
  "version": "2.5.0",
  "description": "Core data structures and filesystem abstractions for DocBlocks",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/docblocks.git",
    "directory": "packages/core"
  },
  "homepage": "https://docblocks.com/",
  "keywords": [
    "docblocks",
    "markdown",
    "filesystem",
    "editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//sideEffects": "tsup's split multi-entry build emits bare imports for shared chunks. Mark only those generated chunks as side-effectful so consumer bundlers retain them without treating the public entries as side-effectful.",
  "sideEffects": [
    "./dist/chunk-*.js"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem/index.d.ts",
      "import": "./dist/filesystem/index.js",
      "default": "./dist/filesystem/index.js"
    },
    "./filesystem/indexeddb": {
      "types": "./dist/filesystem/indexeddb.d.ts",
      "import": "./dist/filesystem/indexeddb.js",
      "default": "./dist/filesystem/indexeddb.js"
    },
    "./filesystem/memory": {
      "types": "./dist/filesystem/memory.d.ts",
      "import": "./dist/filesystem/memory.js",
      "default": "./dist/filesystem/memory.js"
    },
    "./filesystem/native": {
      "types": "./dist/filesystem/native.d.ts",
      "import": "./dist/filesystem/native.js",
      "default": "./dist/filesystem/native.js"
    },
    "./filesystem/electron": {
      "types": "./dist/filesystem/electron.d.ts",
      "import": "./dist/filesystem/electron.js",
      "default": "./dist/filesystem/electron.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js",
      "default": "./dist/document/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js",
      "default": "./dist/workspace/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./share": {
      "types": "./dist/share/index.d.ts",
      "import": "./dist/share/index.js",
      "default": "./dist/share/index.js"
    },
    "./vscode": {
      "types": "./dist/vscode/index.d.ts",
      "import": "./dist/vscode/index.js",
      "default": "./dist/vscode/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    },
    "./mcp/zod": {
      "types": "./dist/mcp/zod.d.ts",
      "import": "./dist/mcp/zod.js",
      "default": "./dist/mcp/zod.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bendyline/squisq": "2.11.0",
    "zod": "3.25.76"
  }
}
