{
  "name": "docblocks-vscode",
  "displayName": "DocBlocks",
  "description": "DocBlocks markdown editor powered by Squisq",
  "icon": "resources/extension-icon.png",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "bendyline",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/docblocks.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://docblocks.com/vscode/",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "DocBlocks",
      "properties": {
        "docblocks.autoSave": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically save markdown files 20 seconds after the last edit in the DocBlocks editor. Manual Save and editor close still flush pending changes when disabled."
        },
        "docblocks.accentColor": {
          "type": "string",
          "default": "brown",
          "scope": "window",
          "enum": [
            "brown",
            "green",
            "blue",
            "purple",
            "maroon",
            "orange",
            "gray"
          ],
          "enumDescriptions": [
            "Brown accent",
            "Green accent",
            "Blue accent",
            "Purple accent",
            "Maroon accent",
            "Orange accent",
            "Gray accent"
          ],
          "description": "Accent color used by DocBlocks editor controls in both light and dark VS Code themes."
        },
        "docblocks.writeCanvasTextSize": {
          "type": "number",
          "default": 16,
          "minimum": 12,
          "maximum": 32,
          "scope": "window",
          "description": "Base text size in CSS pixels for the DocBlocks Write canvas."
        },
        "docblocks.writeCanvasLineSpacing": {
          "type": "number",
          "default": 1.7,
          "minimum": 1.2,
          "maximum": 2.4,
          "multipleOf": 0.1,
          "scope": "window",
          "description": "Line-height multiplier for body text in the DocBlocks Write canvas."
        }
      }
    },
    "commands": [
      {
        "command": "docblocks.openEditor",
        "title": "DocBlocks: Open Editor",
        "category": "DocBlocks"
      },
      {
        "command": "docblocks.openInDocBlocks",
        "title": "Open in DocBlocks",
        "category": "DocBlocks"
      },
      {
        "command": "docblocks.openSetup",
        "title": "Open DocBlocks Tools (CLI+MCP) Setup",
        "category": "DocBlocks"
      }
    ],
    "customEditors": [
      {
        "viewType": "docblocks.markdownEditor",
        "displayName": "DocBlocks Editor",
        "selector": [
          {
            "filenamePattern": "**/*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "docblocks.openInDocBlocks",
          "when": "resourceExtname == .md",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "docblocks.openInDocBlocks",
          "when": "resourceExtname == .md",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "docblocks.openInDocBlocks",
          "when": "resourceExtname == .md"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsup && npm run build:webview",
    "build:webview": "vite build --config webview/vite.config.ts",
    "package:vsix": "npm run build && vsce package --no-dependencies",
    "typecheck": "npm run typecheck:extension && npm run typecheck:webview && npm run typecheck:web-e2e && npm run typecheck:desktop-e2e",
    "typecheck:extension": "tsc --noEmit -p tsconfig.json",
    "typecheck:webview": "tsc --noEmit -p webview/tsconfig.json",
    "typecheck:web-e2e": "tsc --noEmit -p tsconfig.e2e-web.json",
    "typecheck:desktop-e2e": "tsc --noEmit -p tsconfig.desktop-e2e.json",
    "test:web": "vscode-test-web --extensionDevelopmentPath=. --browser=none --port=3100",
    "test:e2e": "npm run build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:desktop-host": "npm run build && tsx desktop-e2e/run.ts"
  },
  "dependencies": {
    "@bendyline/docblocks": "*",
    "@bendyline/docblocks-react": "*",
    "@bendyline/squisq": "2.3.2",
    "@bendyline/squisq-editor-react": "2.3.3",
    "@bendyline/squisq-formats": "2.3.2",
    "@bendyline/squisq-react": "2.3.2",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vscode/test-electron": "3.0.0",
    "@vscode/test-web": "0.0.80",
    "@vscode/vsce": "3.9.2",
    "monaco-editor": "0.50.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
