{
  "name": "@bendyline/docblocks-react",
  "version": "2.4.0",
  "description": "React components for DocBlocks — file explorer, workspace picker, and editor shell",
  "license": "MIT",
  "author": "Bendyline",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendyline/docblocks.git",
    "directory": "packages/react"
  },
  "homepage": "https://docblocks.com/",
  "keywords": [
    "docblocks",
    "react",
    "markdown",
    "file-explorer",
    "editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//sideEffects": "Not `false`: `./styles` is a side-effect-only CSS import and `false` would let bundlers tree-shake it away entirely. The JS entries do carry one top-level side effect (the shell imports squisq's stylesheet), but that is preserved whenever the module is retained -- this flag only lets a bundler drop an entry whose exports are wholly unused, which is exactly when its styles are not wanted either.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js",
      "default": "./dist/export/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js",
      "default": "./dist/settings/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./styles": "./src/styles/docblocks.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@bendyline/docblocks": "2.4.0",
    "@bendyline/squisq": "2.8.0",
    "@bendyline/squisq-editor-react": "2.8.0",
    "@bendyline/squisq-formats": "2.4.5",
    "@bendyline/squisq-react": "2.8.0",
    "@bendyline/squisq-video": "2.3.0",
    "@bendyline/squisq-video-react": "2.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.9.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "happy-dom": "20.9.0",
    "mocha": "11.3.0",
    "monaco-editor": "0.50.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
